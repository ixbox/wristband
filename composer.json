{
    "name": "ixbox/edge-identity",
    "description": "Verify user identity passed by an authenticating edge (AWS ALB x-amzn-oidc-data, oauth2-proxy, OIDC bearer tokens). PHP 7.2+, no JWT library dependency.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "alb",
        "oidc",
        "jwt",
        "es256",
        "cognito",
        "oauth2-proxy",
        "authentication"
    ],
    "require": {
        "php": "^7.2 || ^8.0",
        "ext-json": "*",
        "ext-openssl": "*",
        "symfony/polyfill-ctype": "^1.27",
        "symfony/polyfill-php80": "^1.27"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12 || ^2.1",
        "phpunit/phpunit": "^8.5.40 || ^9.6",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "suggest": {
        "ext-curl": "Used to fetch public keys and JWKS (falls back to PHP streams)",
        "psr/http-message": "To build a ProxyRequest from a PSR-7 request",
        "psr/simple-cache": "To share fetched public keys and JWKS between requests (Psr16Cache)"
    },
    "autoload": {
        "psr-4": {
            "Ixbox\\EdgeIdentity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ixbox\\EdgeIdentity\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
